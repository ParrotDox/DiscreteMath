<Window x:Class="Automate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Automate"
        mc:Ignorable="d"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        Height="250" Width="500">
    <Border x:Name="MainBorder"
            Background="#b4cd93"
            CornerRadius="10"
            MouseLeftButtonDown="MainBorder_MouseLeftButtonDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40px"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#427a5b"
                    CornerRadius="10 10 0 0">
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="CloseButton" Content="✖" Style="{StaticResource CloseButton}" Margin="0 0 8 0" Click="CloseButton_Click"/>
                </StackPanel>
            </Border>
            <StackPanel Grid.Row="1" Margin="10">
                <TextBox x:Name="TextBoxInput" Style="{StaticResource TextBoxInput}" Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}"/>
                <StackPanel Orientation="Horizontal" Margin="0 10 0 0">
                    <Button x:Name="AButton" Content="A" Style="{StaticResource InputButton}" Margin="0 0 5 0" Click="AButton_Click"/>
                    <Button x:Name="BButton" Content="B" Style="{StaticResource InputButton}" Margin="0 0 5 0" Click="BButton_Click"/>
                    <Button x:Name="CButton" Content="C" Style="{StaticResource InputButton}" Margin="0 0 5 0" Click="CButton_Click"/>
                    <Button x:Name="DButton" Content="D" Style="{StaticResource InputButton}" Margin="0 0 5 0" Click="DButton_Click"/>
                    <Button x:Name="RandomButton" Content="RND" Style="{StaticResource InputButton}"
                            Margin="0 0 5 0" Command="{Binding PutRandomInputCommand}"/>
                    <Button x:Name="ClearButton" Content="Clear" Style="{StaticResource InputButton}"
                            Margin="0 0 10 0" Click="ClearButton_Click"/>
                    <TextBox Style="{StaticResource TextBoxOutput}" Text="{Binding Result, StringFormat='{}{0}'}" IsReadOnly="True"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
